# IBM watsonx.ai (required)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=skills-network
WATSONX_REGION=us-south

# Vision-language model
LLAMA_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.6
LLM_MAX_TOKENS=2000

# Retrieval
DATASET_PATH=data/swift-style-embeddings.pkl
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=fashion_outfits
SIMILARITY_THRESHOLD=0.8
DEFAULT_ALTERNATIVES_COUNT=5

# Image encoder (must match the published catalog embeddings)
IMAGE_WIDTH=224
IMAGE_HEIGHT=224
NORMALIZATION_MEAN=0.485,0.456,0.406
NORMALIZATION_STD=0.229,0.224,0.225

# Gradio
SERVER_NAME=127.0.0.1
SERVER_PORT=5000
GRADIO_SHARE=false
LOG_LEVEL=INFO
